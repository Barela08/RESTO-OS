# RESTO OS - public browser configuration
# Use the Supabase project URL and publishable key (or legacy anon key).
# NEVER place service_role / secret keys in VITE_* variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy compatibility only; prefer VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Restaurant settings (replace with actual values before deployment)
VITE_DEFAULT_RESTAURANT_ID=YOUR_RESTAURANT_ID
VITE_RESTAURANT_TIMEZONE=Asia/Kolkata
VITE_RESTAURANT_CURRENCY=INR
VITE_RESTAURANT_CURRENCY_SYMBOL=₹

# Optional public Razorpay key ID only. Never put a Razorpay secret here.
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

VITE_ENABLE_SOUND_NOTIFICATIONS=true
